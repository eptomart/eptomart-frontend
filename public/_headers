# Cloudflare Pages — Cache headers for performance

# Digital Asset Links (Android TWA verification)
/.well-known/assetlinks.json
  Content-Type: application/json
  Cache-Control: public, max-age=3600

# HTML — no cache (always fresh)
# NOTE: `/*.html` only matches literal *.html URLs, which this SPA never
# actually serves — every real route (/, /koyambedu, /admin/... etc.) is
# extensionless and gets rewritten to index.html by _redirects, but that
# rewrite happens AFTER header matching, so `/*.html` never applied to any
# real page. Explicit `/` and `/index.html` rules below close that gap
# without touching the /assets, /icons, /manifest.json rules further down
# (Cloudflare joins values when multiple rules match the same header on the
# same request, so we deliberately do NOT use a `/*` wildcard here — that
# would merge into the long-cache asset rules and defeat them).
/
  Cache-Control: no-cache, no-store, must-revalidate
/index.html
  Cache-Control: no-cache, no-store, must-revalidate
/*.html
  Cache-Control: no-cache, no-store, must-revalidate

# JS/CSS assets — long cache (hashed filenames)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Images
/icons/*
  Cache-Control: public, max-age=31536000, immutable

# Manifest + SW — short cache
/manifest.json
  Cache-Control: public, max-age=86400

# Security headers on all pages
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # geolocation=() and payment=() were blocking features this site actually
  # uses for itself: every navigator.geolocation call site-wide (delivery
  # address auto-fill, nearest-store detection, Express's ETA/Quick
  # Delivery badge, the map pickers) was being silently vetoed by the
  # browser at the HTTP-header level — an empty allowlist disables a
  # feature for every context on the origin, including the page's own
  # top-level JS, before any permission prompt can even appear. This is the
  # real root cause behind the recurring "ETA badge never shows" reports.
  # payment=() blocks the Payment Request API, which Razorpay's checkout.js
  # uses on iOS Safari/WKWebView to detect Apple Pay — with it blocked,
  # Razorpay's own payment-method detection can silently fail to complete,
  # matching reports of the payment sheet never appearing specifically on
  # iPhones. camera/microphone stay disabled since nothing on the site uses them.
  Permissions-Policy: camera=(), microphone=(), geolocation=(self), payment=(self)
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-XSS-Protection: 1; mode=block
  Cross-Origin-Opener-Policy: same-origin
